<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.YuyuejiyangDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.YuyuejiyangEntity" id="yuyuejiyangMap">
        <result property="jiyangbianhao" column="jiyangbianhao"/>
        <result property="fuwumingcheng" column="fuwumingcheng"/>
        <result property="tupian" column="tupian"/>
        <result property="fuwujiage" column="fuwujiage"/>
        <result property="jiyangriqi" column="jiyangriqi"/>
        <result property="jiyangtianshu" column="jiyangtianshu"/>
        <result property="zongfeiyong" column="zongfeiyong"/>
        <result property="zhanghao" column="zhanghao"/>
        <result property="xingming" column="xingming"/>
        <result property="shoujihao" column="shoujihao"/>
        <result property="chongwuxinxi" column="chongwuxinxi"/>
        <result property="dengjishijian" column="dengjishijian"/>
        <result property="sfsh" column="sfsh"/>
        <result property="shhf" column="shhf"/>
        <result property="ispay" column="ispay"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.YuyuejiyangVO" >
		SELECT * FROM yuyuejiyang  yuyuejiyang         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.YuyuejiyangVO" >
		SELECT  yuyuejiyang.* FROM yuyuejiyang  yuyuejiyang 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.YuyuejiyangView" >

		SELECT  yuyuejiyang.* FROM yuyuejiyang  yuyuejiyang 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.YuyuejiyangView" >
		SELECT * FROM yuyuejiyang  yuyuejiyang <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

    <select id="selectValue" resultType="map" >
        SELECT ${params.xColumn}, ROUND(sum(${params.yColumn}),1) total FROM yuyuejiyang
        <where> 1=1 ${ew.sqlSegment}</where>
        group by ${params.xColumn}
    </select>

    <select id="selectTimeStatValue" resultType="map" >
        <if test = 'params.timeStatType == "日"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y-%m-%d') ${params.xColumn}, sum(${params.yColumn}) total FROM yuyuejiyang
                <where> 1=1 ${ew.sqlSegment}</where>
                group by DATE_FORMAT(${params.xColumn},'%Y-%m-%d')
        </if>
        <if test = 'params.timeStatType == "月"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y-%m') ${params.xColumn}, sum(${params.yColumn}) total FROM yuyuejiyang
                <where> 1=1 ${ew.sqlSegment}</where>
                group by DATE_FORMAT(${params.xColumn},'%Y-%m')
        </if>
        <if test = 'params.timeStatType == "年"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y') ${params.xColumn}, sum(${params.yColumn}) total FROM yuyuejiyang
                <where> 1=1 ${ew.sqlSegment}</where>
                group by DATE_FORMAT(${params.xColumn},'%Y')
        </if>
    </select>

    <select id="selectGroup" resultType="map" >
        SELECT ${params.column} , count(1) total FROM yuyuejiyang
        <where> 1=1 ${ew.sqlSegment}</where>
        group by ${params.column}
    </select>




</mapper>
